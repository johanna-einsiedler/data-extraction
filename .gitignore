# data & run artefacts (everything under data/ except the split rule + id lists)
data/*
!data/dataset_splits/
trial_cache/
trial_logs/
.env
.DS_Store
pipeline_env/
__pycache__/
*.pyc
*.zip
all_articles/

# caches
.pytest_cache/

# analysis/hpo_analysis/recover.py but are not versionable); manifests only
archive/

# Phase-2 study dir: the three study DBs + provenance scripts are tracked;
# worker logs, point-in-time backups and throwaway studies are not
stage2_analyses/**/logs/
stage2_analyses/**/backups_*/
stage2_analyses/**/*.db.bak*
stage2_analyses/**/smoke.db
stage2_analyses/**/sanity.db
*.db-journal
*.db-wal
*.db-shm

# editor / Excel lock files and ad-hoc backups
~$*
*.bak

# generated test artefacts (written at import / test time)
tests/query_creation/queries_with_prompts.json
tests/test_rcs_rerank_results_*.json

# setuptools metadata recreated by `pip install -e .`
*.egg-info/

# frozen runs: outputs + manifests + ledgers are tracked; per-run caches and locks are not
runs/**/cache.json
runs/**/cache.json.tmp
runs/**/.lock
